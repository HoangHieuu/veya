# Use mock JSON (no backend required) for the wizard/results screens.
# Set false for live API + B dataset.
# Note: the agent workspace (VITE_AGENT_CANVAS) always talks to the live API —
# it is driven by POST /api/agent/turn and has no mock path, so the API on
# port 3001 must be running for chat to work.
VITE_USE_MOCK=true

# Leave empty when using Vite proxy to localhost:3001 (also proxies /assets)
VITE_API_BASE=

# Agent 3-panel workspace (chat · discovery · trip panel)
VITE_AGENT_CANVAS=true

# Optional debug globe tuning panel (off for demo)
VITE_GLOBE_DEBUG=false
