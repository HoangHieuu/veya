# Use mock JSON (no backend required). Set false for live API + B dataset.
VITE_USE_MOCK=true

# Leave empty when using Vite proxy to localhost:3001 (also proxies /assets)
VITE_API_BASE=

# Agent 3-panel workspace (chat · discovery · trip panel)
VITE_AGENT_CANVAS=true

# Optional debug globe tuning panel (off for demo)
VITE_GLOBE_DEBUG=false
