PORT=3001

# Set NODE_ENV=production to disable /dev/scoring by default.
# ENABLE_DEV_SCORING=true can explicitly enable it in production.
# NODE_ENV=development
# ENABLE_DEV_SCORING=false

# Person C — brief gap-fill LLM (server only; never commit real keys)
# Copy to .env and set your key locally.
OPENAI_API_KEY=
INTENT_LLM_ENABLED=true
# Fast models: gpt-4.1-nano (default) or gpt-5-nano
OPENAI_MODEL=gpt-4.1-nano

# Agent chat understanding (POST /api/agent/turn).
# On by default whenever OPENAI_API_KEY is set. Set to false to force the
# deterministic parser only — the chat still reads origins, destinations,
# travellers, date ranges and fare names without any network call.
# AGENT_LLM_ENABLED=false

# Policy RAG (POST /api/policy/ask and free-text policy questions in chat)
# also uses OPENAI_API_KEY; without a key the agent declines policy questions
# rather than answering from memory.
